  "historical_imputation_semantics": {
    "version": "successor-mission-task.v1",
    "evidence_class": "HISTORICAL_PROTOCOL_IMPUTATION",
    "assumption": "The structural intervals in a handoff prepare its declared successor problem. Multiple intervals may prepare the same successor. Goal is terminal navigation. No task was directly recorded before the historical structural actions. The assignment is reconstructed from the predeclared mission plan, not target morphology, future states/actions, outcomes or the next Canonical row.",
    "boundary": "Switch at interval start; preserve the successor as a floor after the interval so stale predecessor locators cannot switch the task back. Current modern geometric mission locators may advance to later segments; legacy morphology-based locators are ignored.",
    "geometry": "Only the selected segment parameters and owned physical fixtures plus explicitly listed shared physical support are exposed."
  },
